{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Churn Demo Output",
  "type": "object",
  "required": [
    "trait",
    "state",
    "meta",
    "intent",
    "recommended_primitives",
    "kpi_hypothesis",
    "confidence",
    "trace_id"
  ],
  "properties": {
    "trait": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "state": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "meta": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "intent": {
      "type": "string"
    },
    "recommended_primitives": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1
    },
    "kpi_hypothesis": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "trace_id": {
      "type": "string"
    }
  }
}
