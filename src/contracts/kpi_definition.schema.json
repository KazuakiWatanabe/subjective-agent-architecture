{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "KPI Definition",
  "type": "object",
  "required": [
    "kpis"
  ],
  "properties": {
    "kpis": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "name",
          "definition",
          "numerator",
          "denominator",
          "frequency",
          "owner",
          "status"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "definition": {
            "type": "string"
          },
          "numerator": {
            "type": "string"
          },
          "denominator": {
            "type": "string"
          },
          "frequency": {
            "type": "string"
          },
          "owner": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "hypothesis",
              "confirmed"
            ]
          }
        }
      }
    }
  }
}
